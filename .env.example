# GitHub Personal Access Token (optional but recommended)
# Increases API rate limit from 60 to 5000 req/hour
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo (for public repos, no scope needed)
VITE_GITHUB_TOKEN=

# Ollama URL for AI-powered module summaries (optional)
# Run: OLLAMA_ORIGINS="*" ollama serve
# Model: ollama pull codellama:7b-code-q4_0
VITE_OLLAMA_URL=http://localhost:11434
